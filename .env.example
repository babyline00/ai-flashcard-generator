# SQLite database file (absolute path required by Prisma on this sandbox).
DATABASE_URL="file:/home/z/my-project/apps/101-ai-flashcard-generator/db/custom.db"

# Optional — disable the live LLM and use the deterministic MockProvider instead.
# Useful for offline dev / CI. Set to "1" to disable.
PKC_DISABLE_LLM=0

# Optional — z-ai-web-dev-sdk credentials (read by the SDK from its own config file
# in production; listed here for documentation only).
# ZAI_API_KEY=
